{
  "name": "jt-website-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "axios": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.1.5",
    "react-scripts": "5.0.1",
    "typescript": "^5.9.2",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build": "DISABLE_ESLINT_PLUGIN=true react-app-rewired build",
    "build:with-images": "npm run optimize:images && react-app-rewired build",
    "build:analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "build:performance": "npm run build && npx lighthouse http://localhost:3000 --view",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "performance:audit": "npx lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json",
    "performance:budget": "npx lighthouse-ci autorun --budgetPath=./performance-budget.json",
    "performance:test": "node scripts/simple-performance-test.js",
    "performance:full": "npm run performance:test && npm run performance:audit && npm run performance:budget",
    "optimize:images": "node scripts/enhanced-image-optimizer.js",
    "image:guide": "node scripts/image-conversion-guide.js",
    "build:full": "npm run optimize:images && npm run build && npm run performance:test",
    "optimize:all": "npm run optimize:images && npm run build && npm run performance:test",
    "test:changes": "node scripts/test-changes.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@craco/craco": "^7.1.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-google-recaptcha": "^2.1.9",
    "compression-webpack-plugin": "^11.1.0",
    "lighthouse": "^12.8.2",
    "react-app-rewired": "^2.2.1",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "description": "This project was bootstrapped with [Create React App](https://github.com/facebook/create-react-app).",
  "main": "server.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
